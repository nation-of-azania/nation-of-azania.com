# ── Core ────────────────────────────────────────────────────────────────────
# Long random string used to sign auth tokens. REQUIRED in production.
# Generate one:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site (no trailing slash). On Vercel it defaults to the
# production domain, so it only needs setting locally.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# "sqlite"   → local file database, zero setup (default for local dev)
# "postgres" → production database (Neon). See README for the migration caveat.
DATABASE_ADAPTER=sqlite

# sqlite:   file URL, e.g. file:./azania.db
# postgres: Neon connection string, e.g.
#           postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=file:./azania.db

# ── File storage (production) ───────────────────────────────────────────────
# When set, media uploads are stored in Vercel Blob instead of the local
# ./media directory. Leave unset for local dev.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX

# ── Seed script (`pnpm seed`) ───────────────────────────────────────────────
# Credentials for the local admin user. Production reads the same two names
# from the Vercel project's environment on its first deploy (README → First
# deploy). Accounts are username-only — no email addresses exist in the system
# and no email adapter is configured (Payload would only log mail to the console).
SEED_ADMIN_USERNAME=IPaaat
SEED_ADMIN_PASSWORD=change-me-immediately

# ── Discord announcements (optional) ────────────────────────────────────────
# Usually set in the admin panel (Settings → Discord). As a fallback, a
# webhook URL here announces newly published articles; DISCORD_WEBHOOK_<SLUG>
# (e.g. DISCORD_WEBHOOK_TIMES) sends one top-level context elsewhere. Locally,
# a http://localhost URL works for trying it out.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
