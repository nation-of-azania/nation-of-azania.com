# Production credentials for `pnpm prod` (ad-hoc Payload CLI commands against
# Neon, e.g. `pnpm prod migrate:status`). Copy to .env.ship (git-ignored).
# Deploys don't need this file: pushing main deploys, and the Vercel build
# reads these values from the project's environment variables.
#
# Keep .env itself pointed at local SQLite dev; running the dev server against
# the production database is how data gets destroyed.

DATABASE_ADAPTER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Vercel → Storage → your Blob store → the read-write token. Needed only if a
# command you run uploads media (e.g. seeding), so files land in Blob rather
# than on your local disk.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX
